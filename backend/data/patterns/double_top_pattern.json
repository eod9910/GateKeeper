{
  "pattern_id": "double_top_pattern",
  "name": "Double Top (Pattern)",
  "category": "chart_patterns",
  "description": "Bulkowski-style double top reversal detector. Finds two roughly equal peaks separated by a valley, validates prior-uptrend context, and (optionally) requires a confirmed close below the valley low. Emits measured-move target and Bulkowski reference statistics on every candidate.",
  "author": "system",
  "version": "1.0.0",
  "plugin_file": "plugins/double_top_pattern.py",
  "plugin_function": "run_double_top_pattern_plugin",
  "pattern_type": "double_top_pattern",
  "artifact_type": "pattern",
  "composition": "primitive",
  "indicator_role": "anchor_structure",
  "pattern_role": "reversal_structure_pattern",
  "library_tier": "core_stable",
  "autonomy_safe": true,
  "state_compatible": true,
  "cost_class": "moderate",
  "search_tags": ["double_top", "reversal", "bulkowski", "bearish", "rdp", "neckline", "measured_move"],
  "source_kind": "native",
  "default_structure_config": {
    "swing_method": "rdp",
    "swing_epsilon_pct": 0.08,
    "use_exact_epsilon": true
  },
  "default_setup_params": {
    "pattern_type": "double_top_pattern",
    "lookback_bars": 220,
    "pivot_source": "rdp",
    "swing_epsilon_pct": 0.08,
    "use_exact_epsilon": true,
    "peak_symmetry_pct": 0.05,
    "valley_depth_min_pct": 0.10,
    "min_bars_between_peaks": 10,
    "require_prior_uptrend": true,
    "confirm_close_below_valley": true,
    "pullback_proximity_pct": 0.02,
    "min_score": 0.55,
    "max_candidates": 2
  },
  "default_entry": {
    "entry_type": "neckline_break_or_pullback"
  },
  "tunable_params": [
    {
      "key": "swing_epsilon_pct",
      "label": "RDP Epsilon",
      "type": "float",
      "min": 0.01,
      "max": 0.20,
      "step": 0.005,
      "default": 0.08
    },
    {
      "key": "use_exact_epsilon",
      "label": "Exact Epsilon",
      "type": "bool",
      "default": true
    },
    {
      "key": "lookback_bars",
      "label": "Lookback Bars",
      "type": "int",
      "min": 80,
      "max": 500,
      "default": 220
    },
    {
      "key": "pivot_source",
      "label": "Pivot Source",
      "type": "select",
      "options": ["rdp", "structure", "auto"],
      "default": "rdp"
    },
    {
      "key": "peak_symmetry_pct",
      "label": "Peak Symmetry (Bulkowski ~5%)",
      "type": "float",
      "min": 0.01,
      "max": 0.15,
      "step": 0.005,
      "default": 0.05
    },
    {
      "key": "valley_depth_min_pct",
      "label": "Min Valley Depth (Bulkowski ~10%)",
      "type": "float",
      "min": 0.03,
      "max": 0.30,
      "step": 0.01,
      "default": 0.10
    },
    {
      "key": "min_bars_between_peaks",
      "label": "Min Bars Between Peaks",
      "type": "int",
      "min": 3,
      "max": 60,
      "default": 10
    },
    {
      "key": "require_prior_uptrend",
      "label": "Require Prior Uptrend",
      "type": "bool",
      "default": true
    },
    {
      "key": "confirm_close_below_valley",
      "label": "Require Confirmed Break",
      "type": "bool",
      "default": true
    },
    {
      "key": "pullback_proximity_pct",
      "label": "Pullback Band Width",
      "type": "float",
      "min": 0.0,
      "max": 0.10,
      "step": 0.005,
      "default": 0.02
    },
    {
      "key": "min_score",
      "label": "Min Score",
      "type": "float",
      "min": 0.25,
      "max": 0.95,
      "step": 0.05,
      "default": 0.55
    }
  ],
  "default_risk_config": {
    "stop_type": "atr_multiple",
    "atr_length": 14,
    "atr_multiplier": 2.0,
    "take_profit_R": 2.0,
    "max_hold_bars": 30,
    "max_concurrent_positions": 3
  },
  "backtest_config": {
    "direction": "short"
  },
  "suggested_timeframes": ["D", "W"],
  "min_data_bars": 40,
  "status": "experimental",
  "bulkowski_priors": {
    "source": "Bulkowski, Encyclopedia of Chart Patterns, 3rd ed.",
    "failure_rate": 0.11,
    "avg_decline_pct": 0.20,
    "pullback_rate": 0.59,
    "notes": "Statistics are reference priors only. Validator/sweep should derive symbol/regime-specific values from backtest results, not these constants."
  }
}
