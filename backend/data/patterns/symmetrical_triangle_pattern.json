  "default_risk_config": {
    "stop_type": "atr_multiple",
    "atr_length": 14,
    "atr_multiplier": 2.0,
    "take_profit_R": 2.0,
    "max_hold_bars": 30,
    "max_concurrent_positions": 3
  },
  "backtest_config": {
    "direction": "long"
  },
  "suggested_timeframes": ["D", "W"],
  "min_data_bars": 50,
