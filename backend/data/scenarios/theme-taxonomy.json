      "themes": 20,
      "by_category": {
        "macro": 5,
        "geopolitical": 4,
        "commodity": 3,
        "policy": 2,
        "sector": 2,
        "tech": 2,
        "consumer": 2
      }
    },
    "review_checklist_for_user": [
      "Do the 20 themes cover the scenarios you actually want surfaced?",
      "Any obvious gaps (e.g. crypto regime, biotech FDA cycle, regional banks)?",
      "Are the ticker_seeds the right 5-10 names per sector, or should some be swapped (e.g. defense — drop GD, add HII)?",
      "Are the first_order / second_order chains directionally correct? (Especially the second-order — these are the Camillo-edge picks.)",
      "Are the magnitude labels (small / moderate / large) calibrated to your gut?"
    ],
    "schema": {
      "theme_key": "snake_case stable id; FK target for market_situations.primary_theme",
      "display_name": "Human-readable label for UI filter chip",
      "category": "macro | geopolitical | commodity | policy | sector | tech | consumer",
      "taxonomy_version": "Bumps when first/second-order or ticker_seeds change; recompute job re-derives situation_exposure",
      "first_order": "Direct, immediate consequences. Each entry = {asset_type, asset_key, direction, magnitude}",
      "second_order": "Differentiated, knock-on consequences. Same shape. Where Camillo edge lives.",
      "ticker_seeds": "Per-sector preferred ticker basket; preferred over the catalog join when present"
    },
    "magnitude_definitions": {
      "small": "Material but bounded; ≤ 5% expected single-name move from theme realization",
      "moderate": "5-15% expected single-name move",
      "large": "≥ 15% expected single-name move"
    }
  },

