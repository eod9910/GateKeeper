    "swing_epsilon_pct": 0.05
  },
  "setup_config": {
    "pattern_type": "pullback_uptrend_entry_composite",
    "composite_spec": {
      "intent": "entry",
      "stages": [
        {
          "id": "timing",
          "pattern_id": "macd_divergence_primitive_v2",
          "params": {
            "divergence_type": "bullish"
          }
        },
        {
          "id": "regime",
          "pattern_id": "regime_filter",
          "params": {
            "reference_symbol": "SPY",
            "required_regime": "expansion"
          }
        }
      ],
      "reducer": {
        "op": "AND",
        "inputs": [
          "timing",
          "regime"
        ]
      }
    },
    "state_machine": {
      "initial_phase": "idle",
      "watch_bars": 5,
      "invalidate_on": "",
      "emit_on": [
        "armed",
        "watching"
      ],
      "transitions": [
        {
          "from": "idle",
          "on_primitive": "macd_divergence_primitive_v2",
          "to": "armed",
          "action": {
            "set_watch_bars": 5,
            "set_flag": "divergence_confirmed"
          }
        },
        {
          "from": "armed",
          "on_primitive": "macd_divergence_primitive_v2",
          "to": "watching"
        }
      ]
    }
  },
