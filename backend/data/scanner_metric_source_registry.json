    "survivability": [
      {
        "label": "Cash",
        "field_path": "totalCash",
        "classification": "sec_primary",
        "primary_source": "sec_companyfacts_bulk",
        "fallback_sources": [
          "vendor_pit_hydration"
        ],
        "composition": [
          "CashAndCashEquivalentsAtCarryingValue",
          "MarketableSecuritiesCurrent"
        ],
        "notes": "Now SEC-first for filing-eligible symbols."
      },
      {
        "label": "OpCF TTM",
        "field_path": "operatingCashFlowTTM",
        "classification": "sec_primary",
        "primary_source": "sec_companyfacts_bulk",
        "fallback_sources": [
          "vendor_pit_hydration"
        ],
        "composition": [
          "sum(last 4 usable quarterly NetCashProvidedByUsedInOperatingActivities)",
          "fallback to latest annual operating cash flow"
        ]
      },
      {
        "label": "FCF TTM",
        "field_path": "freeCashFlowTTM",
        "classification": "derived",
        "primary_source": "local_derivation",
        "fallback_sources": [
          "vendor_pit_hydration"
        ],
        "formula": "operatingCashFlowTTM - capitalExpendituresTTM",
        "inputs_preferred_source": "sec_companyfacts_bulk"
      },
      {
        "label": "Burn / Q",
        "field_path": "quarterlyCashBurn",
        "classification": "derived",
        "primary_source": "local_derivation",
        "fallback_sources": [
          "vendor_pit_hydration"
        ],
        "formula": "absolute average of recent negative quarterly FCF, else negative OCF"
      },
      {
        "label": "Runway",
        "field_path": "cashRunwayQuarters",
        "classification": "derived",
        "primary_source": "local_derivation",
        "fallback_sources": [],
        "formula": "totalCash / quarterlyCashBurn"
      },
      {
        "label": "Cash / MCap",
        "field_path": "cashPctMarketCap",
        "classification": "derived",
        "primary_source": "local_derivation",
        "fallback_sources": [],
        "formula": "totalCash / marketCap * 100"
      },
      {
        "label": "Current Ratio",
        "field_path": "currentRatio",
        "classification": "derived",
        "primary_source": "local_derivation",
        "fallback_sources": [
          "vendor_pit_hydration"
        ],
        "formula": "currentAssets / currentLiabilities",
        "inputs_preferred_source": "sec_companyfacts_bulk"
      },
      {
        "label": "Quick Ratio",
        "field_path": "quickRatio",
        "classification": "derived",
        "primary_source": "local_derivation",
        "fallback_sources": [
          "vendor_pit_hydration"
        ],
        "formula": "(cashAndEquivalents + marketableSecuritiesCurrent + receivablesCurrent) / currentLiabilities",
        "inputs_preferred_source": "sec_companyfacts_bulk"
      }
    ],
