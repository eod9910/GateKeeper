{
  "version": 1,
  "updated_at": "2026-04-01",
  "policy": {
    "statement_financials": {
      "rule": "SEC primary-source first, vendor backfill second",
      "primary_sources": [
        "sec_companyfacts_bulk",
        "sec_docling_probe"
      ],
      "fallback_sources": [
        "vendor_pit_hydration",
        "stockdex"
      ]
    },
    "market_trading_context": {
      "rule": "Vendor/market data first",
      "primary_sources": [
        "vendor_pit_hydration",
        "stockdex"
      ]
    },
    "heuristics_and_scores": {
      "rule": "Compute locally from canonical resolved inputs",
      "primary_sources": [
        "local_derivation"
      ]
    }
  },
  "field_types": {
    "sec_primary": "Value should resolve from SEC/companyfacts or filing extraction first.",
    "vendor_primary": "Value is primarily a vendor/market data field.",
    "vendor_composed": "Vendor exposes a composed value built from more primitive facts.",
    "derived": "Computed locally from underlying canonical fields.",
    "heuristic": "Interpretive score, label, or summary generated from lower-level metrics."
  },
  "sections": {
    "summary_cards": [
      {
        "label": "Tactical",
        "field_path": "tacticalGrade",
        "classification": "heuristic",
        "primary_source": "local_derivation",
        "fallback_sources": [],
        "notes": "UI falls back to holdContext if tacticalGrade is absent."
      },
      {
        "label": "Runway",
        "field_path": "cashRunwayQuarters",
        "classification": "derived",
        "primary_source": "local_derivation",
        "fallback_sources": [
          "sec_companyfacts_bulk",
          "vendor_pit_hydration"
        ],
        "formula": "totalCash / quarterlyCashBurn when burn > 0; 99 when burn == 0"
      },
      {
        "label": "Survival",
        "field_path": "survivabilityScore",
